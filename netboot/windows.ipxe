goto skip_vbox-2
:use_vbox-2
initrd ${giturlraw}/win10/drv/vbox/VBoxGuest.inf VBoxGuest.inf
initrd ${giturlraw}/win10/drv/vbox/VBoxGuest.cat VBoxGuest.cat
initrd ${giturlraw}/win10/drv/vbox/VBoxGuest.sys VBoxGuest.sys
