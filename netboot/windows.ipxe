#!ipxe
set menu-timeout 300000
set submenu-timeout ${menu-timeout}
isset ${menu-default} || set menu-default starter
set submenu-timeout ${menu-timeout}

set giturl https://github.com/amidevous2/ipxewindows
set giturlraw https://raw.githubusercontent.com/amidevous2/ipxewindows/refs/heads/main

menu
item retrun                    Return
item starter          windows 7 32 bit starter
item premium32      	windows 7 32 bit familiale premium
item premium64      	windows 7 64 bit familiale premium
item shell            Shell iPXE
item exit             Exit

choose --timeout ${menu-timeout} --default ${menu-default} target && goto ${target}

:retrun
chain ${giturlraw}/netboot.ipxe

:starter
chain ${giturlraw}/netboot.ipxe

:premium32
chain ${giturlraw}/premium32.ipxe


:premium64
chain ${giturlraw}/premium64.ipxe

:shell
shell

:exit
exit
