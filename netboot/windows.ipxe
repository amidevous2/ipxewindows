initrd     ${giturlraw}/win7/dvr/x86/vmware/vmxnet3.sys vmxnet3.sys ||
:skip_e1d68-2
iseq ${pciid} 1af41000-2 && goto use_virtio-2 ||
goto skip_virtio-2
:use_virtio-2
# without extra name wimboot crashes (in pcbios mode)
initrd     ${giturlraw}/win10/drv/virtio-win-0.1.240/Balloon/w10/x86/balloon.cat   balloon.cat ||
initrd     ${giturlraw}/win10/drv/virtio-win-0.1.240/Balloon/w10/x86/balloon.inf   balloon.inf ||
