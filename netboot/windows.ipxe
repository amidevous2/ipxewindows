initrd     ${giturlraw}/win7/dvr/x86/vmware/vmusbmouse.sys vmusbmouse.sys ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmxnet3.PNF vmxnet3.PNF ||
