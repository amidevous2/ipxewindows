imgfetch --name boot.wim https://github.com/amidevous2/ipxewindows/releases/download/windows10/boot.i386.wim boot.wim
#echo wimboot.i386:
#imgstat wimboot.i386
#echo bcd:
#imgstat bcd
#echo boot.sdi:
#imgstat boot.sdi
#echo install.bat:
#imgstat install.bat
#echo winpeshl.ini:
#imgstat winpeshl.ini
#echo winpe.jpg:
#imgstat winpe.jpg
#echo boot.wim:
#imgstat boot.wim
#sleep 200
#imgstat
boot || goto menu

:item3
kernel ${giturl}/releases/download/windows10/wimboot gui quiet || shell
initrd ${giturl}/releases/download/windows10/bcd bcd
initrd ${giturl}/releases/download/windows10/boot.sdi boot.sdi
initrd ${giturlraw}/win7/autounattend/x64/efi/install.bat install.bat
initrd ${giturlraw}/winpeshl.ini winpeshl.ini
initrd --name winpe.jpg ${giturlraw}/win10/winpe.jpg || echo no background - ignored
initrd --name winre.jpg ${giturlraw}/win10/winpe.jpg || echo no background - ignored
initrd --name setup.bmp ${giturlraw}/win10/winpe.jpg || echo no background - ignored
# E1D68
# TODO 0d4f only installing drivers in winpe, not when getting into windows.
# 15fc on T15 not working in winpe either
# TODO also fix ipxe sources and test
iseq ${pciid} 80860d4f && goto use_e1d68 ||
iseq ${pciid} 808615fc && goto use_e1d68 ||
iseq ${pciid} 808615bb && goto use_e1d68 ||
iseq ${pciid} 808615be && goto use_e1d68 ||
goto skip_e1d68-3
:use_e1d68-3
