#!ipxe
set menu-timeout 300000
#set menu-timeout 1
set submenu-timeout ${menu-timeout}
isset ${menu-default}
set menu-default item3
set nloc ${netX/busloc}
set pciid ${pci/${nloc}.0.2}${pci/${nloc}.2.2}
set submenu-timeout ${menu-timeout}
set commit main
set winver win7
set winversion windows7
set arch1 x86
set arch2 x86
set arch3 i386
set lang french
set giturl https://github.com/amidevous2/ipxewindows
set giturlraw https://raw.githubusercontent.com/amidevous2/ipxewindows/refs/heads/main

menu
item retrun            	                Return
item item2      	windows 7 32 bit Legacy manual install ${pciid}
item item3      	windows 7 64 bit Legacy manual install ${pciid}
item item4      	windows 7 English
item item5		windows 7 French
item item6		netboot
item shell              Shell iPXE
item exit              	Exit

choose --timeout ${menu-timeout} --default ${menu-default} target && goto ${target}

:retrun
chain ${giturlraw}/netboot.ipxe

:item2
chain ${giturlraw}/netboot.ipxe

:item3
chain ${giturlraw}/netboot.ipxe


:item4
set conn_type https
chain ${giturlraw}/netboot.ipxe


:item5
set conn_type https
chain ${giturlraw}/netboot.ipxe

:item6
set conn_type https
chain ${giturlraw}/netboot.ipxe
exit


:shell
shell

:exit
exit
