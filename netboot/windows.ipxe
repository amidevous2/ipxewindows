initrd     ${giturlraw}/win7/dvr/x86/vmware/vmaudio.cat vmaudio.cat ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmaudio.inf vmaudio.inf ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmaudio.sys vmaudio.sys ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmci.PNF vmci.PNF ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmci.cat vmci.cat ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmci.inf vmci.inf ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmci.sys vmci.sys ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmmouse.PNF vmmouse.PNF ||
initrd     ${giturlraw}/win7/dvr/x86/vmware/vmmouse.inf vmmouse.inf ||
