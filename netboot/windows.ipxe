#initrd ${giturlraw}/win7/autounattend/x86/starter/french/legacy/autounattend.xml autounattend.xml
#initrd https://github.com/amidevous/wimboot-install/raw/refs/heads/main/win7/autounattend/x64/legacy/7-zip.dll 7-zip.dll
