iseq ${pciid} 808615be && goto use_e1d68-2 ||
iseq ${pciid} 8086100f && goto use_e1d68-2 ||
iseq ${pciid} 8086100e && goto use_intele1000 ||
goto skip_intele1000
:use_intele1000
