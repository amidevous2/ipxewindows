#!ipxe
set menu-timeout 300000
#set menu-timeout 1
set submenu-timeout ${menu-timeout}
isset ${menu-default} || set menu-default return
set nloc ${netX/busloc}
set pciid ${pci/${nloc}.0.2}${pci/${nloc}.2.2}
set submenu-timeout ${menu-timeout}
set commit main
set winver win7
set winversion windows7
set arch1 x86
set arch2 x86
set arch3 i386
set lang french
set giturl https://github.com/amidevous2/ipxewindows
set giturlraw https://raw.githubusercontent.com/amidevous2/ipxewindows/refs/heads/main

menu
item return        	                Return
item item2      	windows 7 32 bit Legacy starter French ${pciid}
item item3      	windows 7 64 bit Legacy manual install ${pciid}
item item4      	windows 7 English
item item5		windows 7 French
item shell              Shell iPXE
item exit              	Exit

choose --timeout ${menu-timeout} --default ${menu-default} target && goto ${target}

:return
chain ${giturlraw}/netboot.ipxe

:item2
imgfree
kernel https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot.i386 wimboot gui
imgfetch --name bcd ${giturl}/releases/download/windows7/bcd.x86 bcd
imgfetch --name boot.sdi ${giturl}/releases/download/windows7/boot.sdi.x86 boot.sdi
imgfetch --name install.bat ${giturlraw}/win7/autounattend/x86/starter/french/legacy/install.bat install.bat
imgfetch --name winpeshl.ini ${giturlraw}/winpeshl.ini winpeshl.ini
imgfetch --name winpe.jpg ${giturlraw}/win10/winpe.jpg winpe.jpg || echo no background - ignored
imgfetch --name setup.bmp ${giturlraw}/win10/winpe.jpg setup.bmp || echo no background - ignored
# E1D68
# TODO 0d4f only installing drivers in winpe, not when getting into windows.
# 15fc on T15 not working in winpe either
# TODO also fix ipxe sources and test
iseq ${pciid} 80860d4f-2 && goto use_e1d68-2 ||
iseq ${pciid} 808615fc-2 && goto use_e1d68-2 ||
iseq ${pciid} 808615bb-2 && goto use_e1d68-2 ||
iseq ${pciid} 808615be-2 && goto use_e1d68-2 ||
iseq ${pciid} 8086100f-2 && goto use_e1d68-2 ||
iseq ${pciid} 80860d4f && goto use_e1d68-2 ||
iseq ${pciid} 808615fc && goto use_e1d68-2 ||
