[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Intel%
CatalogFile = sxb62x64.cat
DriverVer = 11/04/2019,3.14.206.0

[Manufacturer]
%Intel%     = Intel, NTamd64.6.1,  NTamd64.6.2

[Intel]

[Intel.NTamd64.6.1]
; DisplayName                       Section      DeviceID
; -----------                       -------      --------
%B10A6.Description%                 = NO_DRV,    PCI\VEN_8086&DEV_10A6
%B15AA.KX4.Description%             = B15AA,     PCI\VEN_8086&DEV_15AA
%B15AB.KR.Description%              = B15AB,     PCI\VEN_8086&DEV_15AB
%B15AC.SFP.Description%             = B15AC,     PCI\VEN_8086&DEV_15AC
%B15AD.Copper.Dual.Description%     = B15AD,     PCI\VEN_8086&DEV_15AD
%B15AE.Copper1G.Description%        = B15AE,     PCI\VEN_8086&DEV_15AE

[Intel.NTamd64.6.2]

[NO_DRV]
Characteristics    = 0x01
Include            = machine.inf
Needs              = NO_DRV

[NO_DRV.Services]
Include            = machine.inf
Needs              = NO_DRV.Services

; ------------------------------------------------
; Intel(R) Ethernet Controller X552
; ------------------------------------------------
[B15AA]
Characteristics    = 0x84 ; NCF_HAS_UI | NCF_PHYSICAL
BusType            = 5 ; PCI
DelReg             = Advanced.DelReg
AddReg             = Default.reg, VMQ.reg, DMACoalescing.reg, Uninstall.reg
AddReg             = Powermgmt.reg
CopyFiles          = CopyFiles, MessageDll.CopyFiles, Uninstall.CopyFiles
*IfType            = 6     ; IF_TYPE_ETHERNET_CSMACD
*MediaType         = 0     ; NdisMedium802_3
*PhysicalMediaType = 14    ; NdisPhysicalMedium802_3

[B15AA.Services]
AddService = %ServiceName%, 2, Service, EventLog

[B15AA.HW]
Include            = machine.inf
Needs              = PciIoSpaceNotRequired
AddReg             = MSI.reg

[B15AA.CoInstallers]
AddReg             = CoInstaller_AddReg, CoInKPM.reg
CopyFiles          = CoInstallerCopyFiles

; ------------------------------------------------
; Intel(R) Ethernet Controller X552
; ------------------------------------------------
[B15AB]
Characteristics    = 0x84 ; NCF_HAS_UI | NCF_PHYSICAL
BusType            = 5 ; PCI
DelReg             = Advanced.DelReg
AddReg             = Default.reg, VMQ.reg, DMACoalescing.reg, Uninstall.reg
AddReg             = Powermgmt.reg
CopyFiles          = CopyFiles, MessageDll.CopyFiles, Uninstall.CopyFiles
*IfType            = 6     ; IF_TYPE_ETHERNET_CSMACD
*MediaType         = 0     ; NdisMedium802_3
*PhysicalMediaType = 14    ; NdisPhysicalMedium802_3

[B15AB.Services]
AddService = %ServiceName%, 2, Service, EventLog

[B15AB.HW]
